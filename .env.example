# Copy to .env.local and fill in. All of these are read from .env.local by both
# Next.js (dev/build/runtime) and the Prisma config (prisma.config.ts).

# --- Database: Supabase Postgres (required) ---------------------------------
# From your Supabase project: Connect -> ORMs / Prisma.
#   DATABASE_URL = transaction pooler (port 6543), used by the app. Append
#                  ?pgbouncer=true
#   DIRECT_URL   = session pooler (port 5432), used only for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth.js (required) ---------------------------------------------------
# Generate one: openssl rand -base64 33
AUTH_SECRET=

# --- LLM (optional) ----------------------------------------------------
# With no key, the app / tests / eval run on the deterministic MockProvider —
# zero network, zero cost. The provider factory (src/lib/llm) picks
# OpenAIProvider automatically when OPENAI_API_KEY is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
