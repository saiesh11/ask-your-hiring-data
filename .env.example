# Copy this file to .env.local and fill in a key to enable the real OpenAI-backed
# provider. With NO key present, the app, the test suite, and the eval suite all run
# entirely on the deterministic MockProvider — zero network calls, zero cost.
#
# The provider factory (src/lib/llm) selects OpenAIProvider automatically when
# OPENAI_API_KEY is set, and MockProvider otherwise. Nothing else changes.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
