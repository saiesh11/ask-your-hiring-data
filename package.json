    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "openai": "^7.9.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
